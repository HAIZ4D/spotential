node_modules/
dist/
build/
coverage/
.vite/

# Secrets — never commit. Gemini AI Studio key lives here locally,
# Secret Manager in deployed environments.
.env
.env.*
!.env.example

# Claude Code — local working context, deliberately not published.
#
# These stay on disk and keep working locally; git simply never sees them.
# CLAUDE.md pulls in the two spec docs via @-imports, so they travel together
# or not at all. A fresh clone therefore has NO project context or spec —
# copy this set across by hand when moving machines.
.claude/
CLAUDE.md
MEMORY.md
SPEC.md
spotential-feature-spec.md
spotential-tech-stack.md

# Written into the workspace by google-github-actions/auth in CI. There is no
# .gcloudignore, so `gcloud builds submit` honours THIS file: without the line
# below it would upload the job's credentials file to the Cloud Build bucket.
gha-creds-*.json

# Firebase
.firebase/
firebase-debug.log
*-debug.log

# Playwright
playwright-report/
test-results/
.playwright/
blob-report/
.cache/ms-playwright/
# Generated by `npm run test:e2e:settled` (scripts/e2e-settled.mjs).
.e2e-settled/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local dev server output
dev.log
